{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(CodeLLDB) C/C++: clang build and debug active file",
            "type": "lldb",
            "console": "integratedTerminal",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.o",
            "args": [],
            "cwd": "${fileDirname}",
            "preLaunchTask": "C/C++: clang build active file"
        },
        {
            "name": "(GDB/LLDB) C/C++: clang build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.o",
            "args": [],
            "cwd": "${fileDirname}",
            "preLaunchTask": "C/C++: clang build active file",
            "MIMode": "lldb",
            // Set to true if the program needs user interaction. This is
            // required because VSCode debug console does not accept
            // user inputs.
            "externalConsole": true 
        }
    ]
}